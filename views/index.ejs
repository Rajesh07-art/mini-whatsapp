<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="app-header">
        <h3>Mini WhatsApp</h3>
        <a href="/chats/new" class="btn btn-primary"> + New Chat</a>
    </div>

    <div class="container">
        <% for(let chat of chats){ %>
            <div class="chat">
                <div class="chat-header">
                    <span class="from">From: <%= chat.from %></span>
                    <span class="to">To: <%= chat.to %></span>
                </div>
                <div class="msg">
                    <p>
                        <%= chat.msg %>
                    </p>
                </div>
                <div class="msg-footer">
                    <span class="timestamp">
                        <%= chat.created_at.toString().split(" ")[4] %> | 
                        <%= chat.created_at.toString().split(" ").slice(0,4).join(" -") %>
                    </span>
                    <div class="actions">
                        <a href="/chats/<%= chat._id %>" class="btn btn-show">Show</a>
                        <a href="/chats/<%= chat._id %>/edit" class="btn btn-edit">Edit</a>
                        <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE" style="display:inline;"
                            onsubmit="return confirm('Are you sure you want to delete this chat?');">
                            <button class="btn btn-delete">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>
    </div>

    <script>
        function confirmDelete(event) {
            let isConfirmed = confirm("Are you sure you want to delete this chat?");
            if (!isConfirmed) {
                event.preventDefault(); // Delete action ko cancel kar dega
                return false;
            }
            return true;
        }
    </script>
</body>

</html>